{
  "scriptFile": "passdown_app.py",
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": ["get", "post", "put", "delete", "options"],
      "route": "api/{route:regex(^(?:health|safety|kudos|today|yesterday)(?:/\\d+)?$)}"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "$return"
    }
  ]
}